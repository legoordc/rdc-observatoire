# Optionnel — active le module ACLED (sécurité/conflits).
# Compte gratuit : https://acleddata.com/register/
ACLED_EMAIL=
ACLED_KEY=

# Optionnel — active l'historique et les courbes de tendance (Supabase, gratuit).
# Project Settings → API, dans le tableau de bord Supabase.
# Utilisez la clé "service_role" (jamais exposée au navigateur, seulement
# utilisée côté serveur dans getStaticProps).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optionnel — envoie les alertes actives sur Slack (webhook entrant gratuit).
# Créez-en un ici : https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Optionnel — seuils d'alerte, valeurs par défaut raisonnables si non définis.
SEUIL_INFLATION=15
SEUIL_HAUSSE_ACLED=1.2

# Aucune clé requise pour : Banque mondiale, OMS, HDX, FMI, UNHCR, BCC, INS,
# ReliefWeb — ces modules fonctionnent dès le premier déploiement.
